# Base path for the SRE Agent API. Defaults to /v1, which the Vite dev server
# proxies to http://localhost:8090 (see vite.config.ts).
VITE_API_BASE=/v1

# Set to 1 to start in dev fixture mode: the UI runs against in-memory sample
# data, including a scripted SSE replay of a full run. Can also be toggled at
# runtime with ?fixtures=1 / ?fixtures=0 or the chip in the top bar.
VITE_FIXTURES=0
